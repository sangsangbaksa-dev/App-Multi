# Cloudflare Pages response headers (replaces the "headers" block of vercel.json). Copied into dist/ by scripts/build-pages.js.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
/app/sw.js
  Cache-Control: no-cache
