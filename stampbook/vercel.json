{
 "buildCommand": "node scripts/build.js",
 "outputDirectory": ".",
 "cleanUrls": true,
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "no-referrer"
    },
    {
     "key": "Content-Security-Policy",
     "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src 'self' https://fiiljdmbnmvtayffsydb.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
    }
   ]
  },
  {
   "source": "/app/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/(docs|scripts|test)/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    }
   ]
  }
 ]
}